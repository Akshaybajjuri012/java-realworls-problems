<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xmlns="http://xmlns.jcp.org/xml/ns/javaee" 
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" 
         id="WebApp_ID" 
         version="4.0">

    <filter>
        <filter-name>TransactionLoggingFilter</filter-name>
        <filter-class>transaction.filter.TransactionLoggingFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>TransactionLoggingFilter</filter-name>
        <url-pattern>/transaction</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>TransactionServlet</servlet-name>
        <servlet-class>transaction.servlet.TransactionServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>TransactionServlet</servlet-name>
        <url-pattern>/transaction</url-pattern>
    </servlet-mapping>

</web-app>
